generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  orders    Order[]
  createdAt DateTime @default(now())
}

model MenuItem {
  id          String      @id @default(uuid())
  name        String
  description String
  price       Float
  image       String
  category    String
  orderItems  OrderItem[]
}

model Order {
  id           String      @id @default(uuid())
  user         User        @relation(fields: [userId], references: [id])
  userId       String
  customerName String
  address      String
  phone        String
  status       OrderStatus @default(ORDER_RECEIVED)
  total        Float
  items        OrderItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model OrderItem {
  id         String   @id @default(uuid())
  order      Order    @relation(fields: [orderId], references: [id])
  orderId    String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  menuItemId String
  quantity   Int
  unitPrice  Float
}

enum OrderStatus {
  ORDER_RECEIVED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
}
